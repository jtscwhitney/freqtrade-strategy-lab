# Freqtrade specific ignores
user_data/data/
user_data/models/
user_data/hyperopt_results/
user_data/plot/
user_data/tradesv3.sqlite*
user_data/tradesv3*.sqlite*
user_data/chat_sessions/

# Local configs — only template is tracked
!config/config-template.json
config/config_cointpairs_lever_sweep_tmp.json

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.venv/
venv/
.env
.envrc

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML training run output (CatBoost, etc.)
catboost_info/

# Cursor — keep rules, ignore local noise
.cursorignore
.cursorindexingignore
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Claude Code — local overrides (may contain paths or preferences)
.claude/settings.local.json

# Sidecar runtime output — logs and collected data are not tracked
sidecar/logs/
sidecar/data/

# Scratch debug / temp exports (e.g. S1 archived-project artifacts, ad-hoc trade dumps)
*temp_*_trades.csv
user_data/s1_*.txt
user_data/s1_*.json

# OS
.DS_Store
Thumbs.db
